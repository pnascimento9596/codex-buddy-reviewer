{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noResolve": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/review-schema.mjs",
    "src/result.mjs",
    "src/approved-provider-request.mjs",
    "src/review-identity.mjs",
    "src/review-aggregate.mjs"
  ]
}
